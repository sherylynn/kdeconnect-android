<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <EditTextPreference
        android:key="adb_host"
        android:title="@string/adb_host"
        android:summary="@string/adb_host_summary"
        android:defaultValue="192.168.1.100"
        android:dialogTitle="@string/adb_host_dialog"
        app:key="adb_host" />

    <EditTextPreference
        android:key="adb_port"
        android:title="@string/adb_port"
        android:summary="@string/adb_port_summary"
        android:defaultValue="5555"
        android:dialogTitle="@string/adb_port_dialog"
        android:inputType="number"
        app:key="adb_port" />

    <SwitchPreferenceCompat
        android:key="auto_connect"
        android:title="@string/adb_auto_connect"
        android:summary="@string/adb_auto_connect_summary"
        android:defaultValue="false"
        app:key="auto_connect" />

    <PreferenceCategory
        android:title="@string/scrcpy_settings_category">

        <ListPreference
            android:key="scrcpy_video_codec"
            android:title="@string/scrcpy_video_codec"
            android:summary="%s"
            android:entries="@array/scrcpy_video_codec_entries"
            android:entryValues="@array/scrcpy_video_codec_values"
            android:defaultValue="h264"
            app:key="scrcpy_video_codec" />

        <EditTextPreference
            android:key="scrcpy_max_size"
            android:title="@string/scrcpy_max_size"
            android:summary="%s"
            android:defaultValue="0"
            android:dialogTitle="@string/scrcpy_max_size_dialog"
            android:inputType="number"
            app:key="scrcpy_max_size" />

        <EditTextPreference
            android:key="scrcpy_max_fps"
            android:title="@string/scrcpy_max_fps"
            android:summary="%s"
            android:defaultValue=""
            android:dialogTitle="@string/scrcpy_max_fps_dialog"
            android:inputType="number"
            app:key="scrcpy_max_fps" />

        <EditTextPreference
            android:key="scrcpy_video_bit_rate"
            android:title="@string/scrcpy_video_bit_rate"
            android:summary="%s bps"
            android:defaultValue="0"
            android:dialogTitle="@string/scrcpy_video_bit_rate_dialog"
            android:inputType="number"
            app:key="scrcpy_video_bit_rate" />

        <SwitchPreferenceCompat
            android:key="scrcpy_control"
            android:title="@string/scrcpy_control"
            android:summary="@string/scrcpy_control_summary"
            android:defaultValue="true"
            app:key="scrcpy_control" />

        <SwitchPreferenceCompat
            android:key="scrcpy_clipboard_sync"
            android:title="@string/scrcpy_clipboard_sync"
            android:summary="@string/scrcpy_clipboard_sync_summary"
            android:defaultValue="true"
            app:key="scrcpy_clipboard_sync" />

        <ListPreference
            android:key="scrcpy_key_inject_mode"
            android:title="@string/scrcpy_key_inject_mode"
            android:summary="@string/scrcpy_key_inject_mode_summary"
            android:entries="@array/scrcpy_key_inject_entries"
            android:entryValues="@array/scrcpy_key_inject_values"
            android:defaultValue="mixed"
            app:key="scrcpy_key_inject_mode" />

        <SwitchPreferenceCompat
            android:key="scrcpy_stay_awake"
            android:title="@string/scrcpy_stay_awake"
            android:summary="@string/scrcpy_stay_awake_summary"
            android:defaultValue="false"
            app:key="scrcpy_stay_awake" />

        <SwitchPreferenceCompat
            android:key="scrcpy_turn_screen_off"
            android:title="@string/scrcpy_turn_screen_off"
            android:summary="@string/scrcpy_turn_screen_off_summary"
            android:defaultValue="false"
            app:key="scrcpy_turn_screen_off" />

        <SwitchPreferenceCompat
            android:key="scrcpy_lock_on_disconnect"
            android:title="@string/scrcpy_lock_on_disconnect"
            android:summary="@string/scrcpy_lock_on_disconnect_summary"
            android:defaultValue="false"
            app:key="scrcpy_lock_on_disconnect" />

        <EditTextPreference
            android:key="scrcpy_app_stream"
            android:title="应用流转"
            android:summary="指定要流转的应用包名（留空=屏幕镜像）"
            android:defaultValue=""
            android:dialogTitle="输入应用包名"
            app:key="scrcpy_app_stream" />

        <EditTextPreference
            android:key="scrcpy_new_display"
            android:title="虚拟屏分辨率"
            android:summary="格式: 宽x高 (如 1920x1080)，留空=默认"
            android:defaultValue=""
            android:dialogTitle="输入虚拟屏分辨率"
            app:key="scrcpy_new_display" />

    </PreferenceCategory>

</PreferenceScreen>
