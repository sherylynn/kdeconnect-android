<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="#222325"
  android:keepScreenOn="true"
  tools:context=".client.view.FullActivity">

  <EditText
    android:id="@+id/edit_text"
    android:layout_width="10dp"
    android:layout_height="10dp"
    android:inputType="textVisiblePassword" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
      android:id="@+id/texture_view_layout"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:gravity="center"
      android:orientation="horizontal">

      <org.kde.kdeconnect.plugins.adbconnection.scrcpy.ScrcpyInputSurfaceView
          android:id="@+id/surface_view"
          android:layout_width="match_parent"
          android:layout_height="match_parent" />
    </LinearLayout>

    <LinearLayout
      android:id="@+id/nav_bar"
      android:layout_width="match_parent"
      android:layout_height="35dp"
      android:layout_gravity="bottom"
      android:visibility="gone"
      android:gravity="center"
      android:orientation="horizontal"
      android:paddingEnd="50dp"
      android:paddingStart="10dp">

      <ImageView
        android:id="@+id/button_rotate"
        android:layout_width="40dp"
        android:layout_height="match_parent"
        android:focusable="false"
        android:padding="4dp"
        android:src="@drawable/rotate"
        android:tint="#DEDEDE" />

      <ImageView
        android:id="@+id/button_switch"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:focusable="false"
        android:padding="4dp"
        android:src="@drawable/square"
        android:tint="#DEDEDE" />

      <ImageView
        android:id="@+id/button_home"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:focusable="false"
        android:padding="4dp"
        android:src="@drawable/o"
        android:tint="#DEDEDE" />

      <ImageView
        android:id="@+id/button_back"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:focusable="false"
        android:padding="4dp"
        android:src="@drawable/caret_left"
        android:tint="#DEDEDE" />

    </LinearLayout>
  </LinearLayout>

  <ImageView
    android:id="@+id/button_more"
    android:layout_width="50dp"
    android:layout_height="35dp"
    android:layout_gravity="end|bottom"
    android:focusable="false"
    android:padding="4dp"
    android:src="@drawable/ellipsis_vertical"
    android:tint="#DEDEDE" />

  <GridLayout
    android:id="@+id/bar_view"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="bottom|end"
    android:visibility="gone"
    android:layout_marginEnd="10dp"
    android:layout_marginBottom="45dp"
    android:background="@drawable/background_cron"
    android:columnCount="4"
    android:elevation="6dp"
    android:padding="8dp">

    <ImageView
      android:id="@+id/button_nav_bar"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_margin="4dp"
      android:focusable="false"
      android:src="@drawable/not_equal"
      android:tint="#FFFFFF" />

    <ImageView
      android:id="@+id/button_mini"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_margin="4dp"
      android:focusable="false"
      android:src="@drawable/minus"
      android:tint="#FFFFFF" />

    <ImageView
      android:id="@+id/button_full_exit"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_margin="4dp"
      android:focusable="false"
      android:src="@drawable/compress"
      android:tint="#FFFFFF" />

    <ImageView
      android:id="@+id/button_close"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_margin="4dp"
      android:focusable="false"
      android:src="@drawable/x_icon"
      android:tint="#ca5357" />

    <ImageView
      android:id="@+id/button_transfer"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_margin="4dp"
      android:focusable="false"
      android:src="@drawable/bars"
      android:tint="#FFFFFF" />

    <ImageView
      android:id="@+id/button_light_off"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_margin="4dp"
      android:focusable="false"
      android:src="@drawable/lightbulb_off"
      android:tint="#FFFFFF" />

    <ImageView
      android:id="@+id/button_power"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_margin="4dp"
      android:focusable="false"
      android:src="@drawable/power_off"
      android:tint="#FFFFFF" />

    <ImageView
      android:id="@+id/button_lock"
      android:layout_width="38dp"
      android:layout_height="38dp"
      android:layout_margin="4dp"
      android:focusable="false"
      android:src="@drawable/lock"
      android:tint="#FFFFFF" />

  </GridLayout>

  <!-- Legacy floating button (kept for compatibility) -->
  <ImageButton
      android:id="@+id/floating_button"
      android:layout_width="48dp"
      android:layout_height="48dp"
      android:layout_gravity="end|center_vertical"
      android:layout_marginEnd="8dp"
      android:src="@android:drawable/ic_menu_more"
      android:background="@drawable/floating_button_bg"
      android:scaleType="centerInside"
      android:visibility="gone" />

  <!-- Legacy floating menu (kept for compatibility) -->
  <ScrollView
      android:id="@+id/floating_menu"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="end|center_vertical"
      android:layout_marginEnd="64dp"
      android:background="#CC000000"
      android:padding="8dp"
      android:visibility="gone"
      android:maxHeight="400dp">

      <GridLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:columnCount="2"
          android:orientation="horizontal">

          <Button
              android:id="@+id/floating_back"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_back"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_home"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_home"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_app_switch"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_app_switch"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_power"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_power"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_volume_up"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_volume_up"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_volume_down"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_volume_down"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_volume_mute"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_volume_mute"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_menu_key"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_menu"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_notification"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_notification"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_screenshot"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_screenshot"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_rotate"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_rotate"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_expand_notif"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_expand_notif"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_expand_settings"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_expand_settings"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

          <Button
              android:id="@+id/floating_collapse_panels"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="@string/scrcpy_collapse_panels"
              android:textSize="11sp"
              android:textColor="@android:color/white"
              android:background="#00000000"
              android:minHeight="36dp"
              android:minWidth="80dp" />

      </GridLayout>
  </ScrollView>

</FrameLayout>