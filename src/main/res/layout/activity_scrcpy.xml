<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <org.kde.kdeconnect.plugins.adbconnection.scrcpy.ScrcpyInputSurfaceView
        android:id="@+id/surface_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Floating control button -->
    <ImageButton
        android:id="@+id/floating_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:src="@android:drawable/ic_menu_more"
        android:background="@drawable/floating_button_bg"
        android:scaleType="centerInside"
        android:contentDescription="@string/scrcpy_floating_button" />

    <!-- Floating button popup -->
    <LinearLayout
        android:id="@+id/floating_menu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="64dp"
        android:orientation="vertical"
        android:background="#CC000000"
        android:padding="8dp"
        android:visibility="gone">

        <Button
            android:id="@+id/floating_back"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scrcpy_back"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="#00000000"
            android:minHeight="36dp" />

        <Button
            android:id="@+id/floating_home"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scrcpy_home"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="#00000000"
            android:minHeight="36dp" />

        <Button
            android:id="@+id/floating_app_switch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scrcpy_app_switch"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="#00000000"
            android:minHeight="36dp" />

        <Button
            android:id="@+id/floating_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scrcpy_power"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:background="#00000000"
            android:minHeight="36dp" />

    </LinearLayout>

</FrameLayout>
