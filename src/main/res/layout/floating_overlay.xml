<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD1A1A1E"
    android:elevation="8dp">

    <TextureView
        android:id="@+id/floating_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Only drag bar — no separate handle views -->
    <FrameLayout
        android:id="@+id/floating_drag_bar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="top"
        android:padding="4dp">
        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#66FFFFFF" />
    </FrameLayout>

    <!-- Bottom bar with handles on sides -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#CC1A1A1E">

        <View
            android:id="@+id/resize_bl"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:background="#44FFFFFF" />

        <ImageView
            android:id="@+id/floating_btn_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/caret_left"
            android:tint="#DEDEDE" />

        <ImageView
            android:id="@+id/floating_btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/o"
            android:tint="#DEDEDE" />

        <ImageView
            android:id="@+id/floating_btn_switch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/square"
            android:tint="#DEDEDE" />

        <ImageView
            android:id="@+id/floating_btn_fullscreen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/compress"
            android:tint="#DEDEDE" />

        <ImageView
            android:id="@+id/floating_btn_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/x_icon"
            android:tint="#ca5357" />

        <View
            android:id="@+id/resize_br"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:background="#44FFFFFF" />
    </LinearLayout>

</FrameLayout>
