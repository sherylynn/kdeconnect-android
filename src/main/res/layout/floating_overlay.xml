<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#DD1A1A1E"
    android:elevation="8dp">

    <TextureView
        android:id="@+id/floating_texture"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Drag bar on top -->
    <FrameLayout
        android:id="@+id/floating_drag_bar"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:layout_gravity="top"
        android:padding="4dp">

        <View
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_gravity="center"
            android:background="#66FFFFFF" />
    </FrameLayout>

    <!-- Control buttons at bottom -->
    <LinearLayout
        android:id="@+id/floating_control_bar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#CC1A1A1E"
        android:paddingHorizontal="4dp">

        <ImageView
            android:id="@+id/floating_btn_back"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/caret_left"
            android:tint="#DEDEDE" />

        <ImageView
            android:id="@+id/floating_btn_home"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/o"
            android:tint="#DEDEDE" />

        <ImageView
            android:id="@+id/floating_btn_switch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/square"
            android:tint="#DEDEDE" />

        <ImageView
            android:id="@+id/floating_btn_fullscreen"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/compress"
            android:tint="#DEDEDE" />

        <ImageView
            android:id="@+id/floating_btn_close"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:focusable="false"
            android:padding="4dp"
            android:src="@drawable/x_icon"
            android:tint="#ca5357" />
    </LinearLayout>

    <!-- Resize handle: bottom-right, above control bar -->
    <View
        android:id="@+id/floating_resize"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="end|bottom"
        android:layout_marginBottom="32dp"
        android:background="#66FFFFFF" />

</FrameLayout>
